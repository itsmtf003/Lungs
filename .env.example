# Copy this file to .env for local use. Never commit a real .env file.
# All values here are placeholders only.

# Database (Milestone 4)
DATABASE_URL=postgresql://user:password@localhost:5432/lesion_fyp
# For a simple local demo, SQLite is allowed: DATABASE_URL=sqlite:///./lesion_fyp.db

# App
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
API_PORT=8000

# Model (Milestone 4)
# Path to an approved model bundle, set only after Milestone 2 is done.
MODEL_BUNDLE_PATH=research/artifacts/releases/hybrid-v1
ACTIVE_MODEL_VERSION=none-yet

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
